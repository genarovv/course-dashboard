[Unit]
Description=Course Dashboard (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cd
Group=cd
WorkingDirectory=/srv/course-dashboard
# Секреты и настройки — вне репозитория, права 600, владелец cd
EnvironmentFile=/etc/course-dashboard.env
# Слушаем только локальный адрес: наружу смотрит обратный прокси, не приложение
ExecStart=/srv/course-dashboard/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
# Миграции сознательно НЕ в ExecStartPre: они выполняются отдельным шагом
# развёртывания, до запуска новой версии. Миграция на каждом старте службы
# при рестартах даёт гонку за базу и прячет ошибку схемы внутрь перезапуска.
Restart=on-failure
RestartSec=5
# Базовое ограничение прав: служба не пишет никуда, кроме своего каталога
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
