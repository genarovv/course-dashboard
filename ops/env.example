# Образец переменных окружения. Значений здесь нет и быть не должно.
# На сервере файл лежит по пути /etc/course-dashboard.env с правами 600,
# владелец — пользователь службы. В репозиторий он не попадает никогда.
#
# Развернуть на сервере:
#   sudo install -m 600 -o cd -g cd /dev/null /etc/course-dashboard.env
#   sudo nano /etc/course-dashboard.env

# Пароль администратора. Читается сидом при первой миграции — задать ДО неё.
# На сервере обязан отличаться от локального.
CD_ADMIN_PASSWORD=

# Ключ подписи сессий. Сгенерировать: openssl rand -hex 32
CD_SECRET_KEY=

# Токен для запуска обхода (заголовок X-Sync-Token). Сгенерировать так же.
CD_SYNC_TOKEN=

# Токены доступа к репозиториям студентов — ТОЛЬКО на чтение (NFR-3).
CD_GITHUB_TOKEN=
CD_GITLAB_TOKEN=

# Ключ модели ядра связности.
CD_DEEPSEEK_API_KEY=

# Смещение отображаемого времени в минутах: 240 = UTC+4.
CD_TZ_OFFSET_MINUTES=240

# Адрес базы. Внимание: команда миграций читает адрес из alembic.ini,
# приложение — отсюда. Значения обязаны совпадать (инцидент 31.07).
CD_DATABASE_URL=sqlite+aiosqlite:////srv/course-dashboard/data/course_dashboard.db
