# Обратный прокси и HTTPS для Course Dashboard.
# Сертификат Let's Encrypt выпускается и продлевается автоматически:
# отдельный планировщик продления не нужен (в связке nginx + certbot нужен,
# и именно он чаще всего незаметно перестаёт срабатывать через три месяца).
#
# Предусловия: запись A домена указывает на этот сервер; порты 80 и 443 открыты.
# Порт 80 нужен и после выпуска — по нему идёт проверка при продлении.

coursedashboard.edunit.org {
	encode gzip

	# Сканерный мусор режется на прокси, до приложения не доходит.
	# Повод — аудит журнала 2026-08-14: боты ищут .env, WordPress,
	# профайлер Symfony и чужие логи; FastAPI отвечал теми же 404,
	# но тратил на это ресурсы и засорял свой журнал.
	# Фильтр консервативный: только классы, которых в приложении нет
	# и не будет; экзотику пусть по-прежнему ловит FastAPI.
	# Классы: .env* в любом месте пути, любой *.php, /wp-* и /wordpress*,
	# профайлер, xmlrpc, .git* в любом месте пути, /var/log/ в пути.
	@scanner path /.env* */.env* *.php /wp-* /wordpress* /_profiler* /xmlrpc* /.git* */.git* /var/log/* */var/log/*
	respond @scanner 404

	reverse_proxy 127.0.0.1:8000

	log {
		output file /var/log/caddy/course-dashboard.log
		format console
	}
}
