#!/bin/sh
# H1 (#52): машинный гейт стандарта тестирования п.3 — «существующие тесты — контракт».
# Блокирует commit, который меняет или удаляет уже отслеживаемые файлы tests/,
# если в сообщении коммита нет строки «tests-change: <обоснование>».
# Новые тестовые файлы (добавление) проходят без пометки.
# Активация: git config core.hooksPath hooks   (README §Хуки и гейты)

msg_file="$1"

changed=$(git diff --cached --name-only --diff-filter=MDR -- 'tests/*.py' 'tests/**/*.py')

if [ -n "$changed" ] && ! grep -qE '^tests-change:[[:space:]]*[^[:space:]]' "$msg_file"; then
    echo "ГЕЙТ ТЕСТОВ: коммит меняет/удаляет существующие тесты:" >&2
    echo "$changed" | sed 's/^/  - /' >&2
    echo "" >&2
    echo "Существующие тесты — контракт (CLAUDE.md, стандарт тестирования п.3):" >&2
    echo "изменение теста = изменение требования и утверждается человеком." >&2
    echo "Если изменение требования согласовано — добавь в сообщение коммита строку:" >&2
    echo "  tests-change: <тикет/решение и обоснование>" >&2
    exit 1
fi

exit 0
